# Required for live generation. Leave blank to explore the interface and bundled example.
REACTOR_API_KEY=
GEMINI_API_KEY=

# Optional: only needed for RevenueCat checkout/access checks, not local generation.
REVENUECAT_PUBLIC_API_KEY=
REVENUECAT_SECRET_API_KEY=

# Optional if the installed applications are not found automatically.
# BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
